#!/usr/bin/env bash
# Stub for macOS-only `networksetup`: records argv, never executes.
if [ -n "${MDOCTOR_STUB_LOG:-}" ]; then
  printf "networksetup %s\n" "$*" >>"$MDOCTOR_STUB_LOG"
fi
# Argv-aware canned output (env-gated; default stays silent so the Task 1.3
# refusal tests and the existing lane behavior are unchanged).
case "${1-}" in
  -listallhardwareports)
    if [ -n "${MDOCTOR_STUB_NETWORKSETUP_PORTS:-}" ]; then
      printf '%s\n' "$MDOCTOR_STUB_NETWORKSETUP_PORTS"
    fi
    ;;
esac
echo "stubbed networksetup: $*" >&2
exit 0

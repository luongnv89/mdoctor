#!/usr/bin/env bash
#
# mdoctor - Unified System Doctor CLI
#
# A single entry-point for checking, cleaning, fixing, and diagnosing macOS / Linux (Debian).
#
# Usage:
#   mdoctor <command> [options]
#
# Commands:
#   check      Run system health audit (read-only)
#   clean      Run system cleanup (dry-run by default)
#   fix        Apply common fixes
#   diagnose   Run active performance diagnosis with bottleneck detection
#   info       Show system information summary
#   list       List all modules with category & risk
#   history    View health score trends over time
#   benchmark  Run disk, network, CPU benchmarks
#   update     Update mdoctor to latest stable release
#   version    Show mdoctor version
#   help       Show this help message
#

set -uo pipefail

########################################
# VERSION
########################################

MDOCTOR_VERSION="3.0.0"

# Append short git commit hash if inside a git repo
_mdoctor_commit=""
if command -v git >/dev/null 2>&1; then
  _mdoctor_commit="$(git -C "$(dirname "$0")" rev-parse --short HEAD 2>/dev/null || true)"
fi
if [ -n "$_mdoctor_commit" ]; then
  MDOCTOR_VERSION_FULL="${MDOCTOR_VERSION}+${_mdoctor_commit}"
else
  MDOCTOR_VERSION_FULL="${MDOCTOR_VERSION}"
fi

########################################
# RESOLVE INSTALL DIRECTORY
########################################

# Find the real script directory (handles symlinks)
resolve_script_dir() {
  local resolved
  # Try realpath first (available on modern macOS)
  if resolved="$(realpath "$0" 2>/dev/null)"; then
    dirname "$resolved"
    return
  fi
  # Try perl as fallback (always available on macOS)
  if resolved="$(perl -e 'use Cwd "abs_path"; use File::Basename; print dirname(abs_path($ARGV[0])) . "\n"' "$0" 2>/dev/null)"; then
    echo "$resolved"
    return
  fi
  # Last resort: use known install location or script dir
  if [ -d "${HOME}/.mdoctor/lib" ]; then
    echo "${HOME}/.mdoctor"
  else
    cd -P "$(dirname "$0")" && pwd
  fi
}

MDOCTOR_DIR="$(resolve_script_dir)"

# Named constants first (Task 8.7): pure assignments, no dependencies.
source "${MDOCTOR_DIR}/lib/constants.sh"
# Module context contract (Task 9.1): declares the 11 globals all modules read.
source "${MDOCTOR_DIR}/lib/context.sh"
mdoctor_context_init
# Source platform detection early (before any platform-conditional logic)
source "${MDOCTOR_DIR}/lib/platform.sh"
source "${MDOCTOR_DIR}/lib/metadata.sh"
source "${MDOCTOR_DIR}/lib/registry.sh"
source "${MDOCTOR_DIR}/lib/disk.sh"
source "${MDOCTOR_DIR}/lib/preflight.sh"
source "${MDOCTOR_DIR}/lib/help.sh"
source "${MDOCTOR_DIR}/lib/clean_common.sh"

# Runtime diagnostics flag (can be enabled per-command via --debug)
MDOCTOR_DEBUG="${MDOCTOR_DEBUG:-false}"

########################################
# COLORS
########################################

if command -v tput >/dev/null 2>&1 && [ -t 1 ]; then
  RED="$(tput setaf 1)"
  GREEN="$(tput setaf 2)"
  YELLOW="$(tput setaf 3)"
  BLUE="$(tput setaf 4)"
  CYAN="$(tput setaf 6)"
  BOLD="$(tput bold)"
  DIM="$(tput dim)"
  RESET="$(tput sgr0)"
else
  RED="" GREEN="" YELLOW="" BLUE="" CYAN="" BOLD="" DIM="" RESET=""
fi

########################################
# HELPERS
########################################

banner() {
  echo "${BOLD}${CYAN}"
  echo '  __  __ ____             _             '
  echo ' |  \/  |  _ \  ___   ___| |_ ___  _ __ '
  echo ' | |\/| | | | |/ _ \ / __| __/ _ \| '\''__|'
  echo ' | |  | | |_| | (_) | (__| || (_) | |   '
  echo ' |_|  |_|____/ \___/ \___|\__\___/|_|   '
  echo "${RESET}"
  echo "${DIM}  Machine Doctor v${MDOCTOR_VERSION_FULL} - Keep your system healthy${RESET}"
  echo
}

error() {
  echo "${RED}Error:${RESET} $*" >&2
}

cmd_clean_preflight_summary_module() {
  local module="${1-}"
  local days="${2:-7}"
  local total_kb=0

  echo
  echo "${BOLD}${YELLOW}== Pre-flight Safety Summary (force mode) ==${RESET}"
  echo "Module: ${module}"
  echo "This run will perform destructive cleanup operations."
  echo "Touched targets:"

  add_path() {
    local label="$1"
    local path="$2"
    local sz=0
    sz=$(preflight_path_kb "$path") || sz=""
    total_kb=$((total_kb + ${sz:-0}))
    if [ -n "$sz" ]; then
      printf "  - %-30s %s (~%s)\n" "$label" "$path" "$(human_readable_kb "$sz")"
    else
      printf "  - %-30s %s (could not determine)\n" "$label" "$path"
    fi
  }

  case "$module" in
    trash)
      add_path "Trash" "$(platform_trash_dir)"
      ;;
    caches)
      add_path "User caches" "$(platform_cache_dir)"
      ;;
    logs)
      local log_dir
      log_dir="$(platform_user_log_dir)"
      local logs_kb=0
      logs_kb=$(preflight_find_kb "$log_dir" -type f -mtime "+${days}") || logs_kb=""
      total_kb=$((total_kb + ${logs_kb:-0}))
      if [ -n "$logs_kb" ]; then
        printf "  - %-30s %s (~%s)\n" "Old logs (>${days}d)" "$log_dir" "$(human_readable_kb "$logs_kb")"
      else
        printf "  - %-30s %s (could not determine)\n" "Old logs (>${days}d)" "$log_dir"
      fi
      ;;
    downloads)
      local dl_kb=0
      dl_kb=$(preflight_find_kb "${HOME}/Downloads" -type f -size +500M -mtime "+${days}") || dl_kb=""
      total_kb=$((total_kb + ${dl_kb:-0}))
      if [ -n "$dl_kb" ]; then
        printf "  - %-30s %s (~%s)\n" "Large downloads (>${days}d)" "${HOME}/Downloads" "$(human_readable_kb "$dl_kb")"
      else
        printf "  - %-30s %s (could not determine)\n" "Large downloads (>${days}d)" "${HOME}/Downloads"
      fi
      ;;
    browser)
      if is_macos; then
        add_path "Chrome cache" "${HOME}/Library/Caches/Google/Chrome"
        add_path "Safari cache" "${HOME}/Library/Caches/com.apple.Safari"
        add_path "Firefox cache" "${HOME}/Library/Caches/Firefox"
      else
        add_path "Chrome cache" "${HOME}/.cache/google-chrome"
        add_path "Firefox cache" "${HOME}/.cache/mozilla/firefox"
        add_path "Chromium cache" "${HOME}/.cache/chromium"
      fi
      ;;
    dev)
      add_path "pip cache" "${HOME}/.cache/pip"
      add_path "npm cache" "${HOME}/.npm"
      if is_macos; then
        add_path "pip cache (Library)" "${HOME}/Library/Caches/pip"
        add_path "npm cache (Library)" "${HOME}/Library/Caches/npm"
        add_path "Yarn cache" "${HOME}/Library/Caches/Yarn"
        add_path "pnpm store" "${HOME}/Library/pnpm/store"
        echo "  - Homebrew cleanup/autoremove (size estimate: n/a)"
      fi
      echo "  - docker system prune -af --volumes (size estimate: n/a) — ONLY with MDOCTOR_ALLOW_DOCKER_PRUNE=true; --volumes deletes named volumes (database data, not just caches)"
      ;;
    crash_reports)
      local crash_dir crash_kb
      while IFS= read -r crash_dir; do
        crash_kb=$(preflight_find_kb "$crash_dir" -type f -mtime "+${days}") || crash_kb=""
        total_kb=$((total_kb + ${crash_kb:-0}))
        if [ -n "$crash_kb" ]; then
          printf "  - %-30s %s (~%s)\n" "Crash reports" "$crash_dir" "$(human_readable_kb "$crash_kb")"
        else
          printf "  - %-30s %s (could not determine)\n" "Crash reports" "$crash_dir"
        fi
      done < <(platform_crash_dirs)
      ;;
    ios_backups)
      local ios_kb=0
      ios_kb=$(preflight_find_kb "${HOME}/Library/Application Support/MobileSync/Backup" -mindepth 1 -maxdepth 1 -type d -mtime "+${days}") || ios_kb=""
      total_kb=$((total_kb + ${ios_kb:-0}))
      if [ -n "$ios_kb" ]; then
        printf "  - %-30s %s (~%s)\n" "iOS backups (>${days}d)" "${HOME}/Library/Application Support/MobileSync/Backup" "$(human_readable_kb "$ios_kb")"
      else
        printf "  - %-30s %s (could not determine)\n" "iOS backups (>${days}d)" "${HOME}/Library/Application Support/MobileSync/Backup"
      fi
      ;;
    xcode)
      add_path "Xcode DerivedData" "${HOME}/Library/Developer/Xcode/DerivedData"
      local arc_kb=0
      arc_kb=$(preflight_find_kb "${HOME}/Library/Developer/Xcode/Archives" -mindepth 1 -maxdepth 1 -type d -mtime "+${days}") || arc_kb=""
      total_kb=$((total_kb + ${arc_kb:-0}))
      if [ -n "$arc_kb" ]; then
        printf "  - %-30s %s (~%s)\n" "Xcode Archives (>${days}d)" "${HOME}/Library/Developer/Xcode/Archives" "$(human_readable_kb "$arc_kb")"
      else
        printf "  - %-30s %s (could not determine)\n" "Xcode Archives (>${days}d)" "${HOME}/Library/Developer/Xcode/Archives"
      fi
      add_path "CoreSimulator caches" "${HOME}/Library/Developer/CoreSimulator/Caches"
      echo "  - xcrun simctl delete unavailable (size estimate: n/a)"
      ;;
    apt)
      add_path "APT cache" "/var/cache/apt/archives"
      echo "  - apt autoremove (size estimate: n/a)"
      ;;
    dev_caches)
      add_path "npm cache" "${HOME}/.npm"
      add_path "pip cache" "${HOME}/.cache/pip"
      add_path "Maven repo" "${HOME}/.m2/repository"
      add_path "Gradle caches" "${HOME}/.gradle/caches"
      add_path "Go module cache" "${HOME}/go/pkg/mod/cache"
      add_path "Cargo cache" "${HOME}/.cargo/registry/cache"
      if is_macos; then
        add_path "Xcode DerivedData" "${HOME}/Library/Developer/Xcode/DerivedData"
      fi
      echo "  - docker system prune -af --volumes (size estimate: n/a) — ONLY with MDOCTOR_ALLOW_DOCKER_PRUNE=true; --volumes deletes named volumes (database data, not just caches)"
      ;;
  esac

  echo
  echo "Estimated reclaim size: ~$(human_readable_kb "$total_kb")"
  echo "${YELLOW}Note:${RESET} estimate is approximate and excludes some command-based cleanup results."
  echo
}

########################################
# COMMAND: check
########################################

# Task 3.3: strict allowlist for check-module names. Rejects paths,
# traversal and option-lookalikes before any path is constructed, then
# requires membership in the platform-filtered registry — a file merely
# existing under checks/ is never enough to source it.
is_valid_check_module() {
  local needle="${1-}"
  case "$needle" in
    ""|*/*|*..*|-*) return 1 ;;
  esac
  case "$needle" in
    *[!a-z0-9_]* ) return 1 ;;
  esac
  get_module_index "$needle" check >/dev/null 2>&1
}

cmd_check() {
  local module=""
  local json_flag=false

  # Shared common-flag parser (Task 8.4): --debug/--help handled once.
  parse_common_args usage_check "$@" || return 0
  set -- ${_COMMON_REST[@]+"${_COMMON_REST[@]}"}

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --module|-m)
        module="$2"
        shift 2
        ;;
      --json)
        json_flag=true
        shift
        ;;
      *)
        error "Unknown option: $1"
        echo "Run 'mdoctor check --help' for usage."
        return 1
        ;;
    esac
  done

  if is_truthy "$json_flag"; then
    export JSON_ENABLED=true
  fi

  if [ "$json_flag" = false ]; then
    echo "${DIM}mdoctor v${MDOCTOR_VERSION_FULL}${RESET}"
  fi

  if [ -n "$module" ]; then
    # Run a single check module — allowlisted before anything is sourced.
    source "${MDOCTOR_DIR}/lib/metadata.sh"
    source "${MDOCTOR_DIR}/lib/registry.sh"
    register_all_modules
    if ! is_valid_check_module "$module"; then
      error "Unknown check module: ${module}"
      echo "Available check modules:"
      list_modules_by_category check
      return 1
    fi
    local check_file="${MDOCTOR_DIR}/checks/${module}.sh"
    if [ ! -f "$check_file" ]; then
      error "Check module file missing: ${check_file}"
      return 1
    fi

    # Source libraries (platform.sh already loaded at top level)
    source "${MDOCTOR_DIR}/lib/common.sh"
    source "${MDOCTOR_DIR}/lib/logging.sh"
    source "${MDOCTOR_DIR}/lib/disk.sh"
    source "${MDOCTOR_DIR}/lib/json.sh"
    source "${MDOCTOR_DIR}/lib/metadata.sh"

    # Globals come from mdoctor_context_init (top level); the single-module
    # path only narrows the progress denominator to this one module.
    ACTIONS=()

    init_colors
    debug_log "cmd_check module=${module} json=${json_flag} debug=${MDOCTOR_DEBUG}"

    # shellcheck source=/dev/null
    source "$check_file"

    # JSON context for --json (issue #90): category/risk come from the
    # registry so single-module output matches the full-audit schema.
    local _json_cat _json_risk
    _json_cat="$(get_module_category "$module" check || true)"
    _json_risk="$(get_module_risk "$module" check || true)"
    json_set_context "$module" "$_json_cat" "$_json_risk"

    # In JSON mode, silence human-readable stdout while running checks.
    if is_truthy "$json_flag"; then
      exec 3>&1
      exec >/dev/null
    fi

    # Registry-driven dispatch (Task 8.1): the function name comes from the
    # single register_module declaration, so the per-module case mapping is
    # no longer a hand-maintained second copy of the registry.
    local _check_func _check_rc=0
    _check_func="$(get_module_func "$module" check 2>/dev/null || true)"
    if [ -n "$_check_func" ]; then
      "$_check_func" || _check_rc=$?
    else
      error "Unknown check module: ${module}"
      return 1
    fi

    # Stop spinner after single-module check
    progress_stop

    # Single-module --json: restore stdout, emit the same document shape
    # as the full audit, and return before the human-readable summary so
    # the payload parses as valid JSON on its own (issues #90, #183).
    # Check records were accumulated in-memory by the status helpers while
    # stdout was silenced; only the actions need adding here.
    if is_truthy "$json_flag"; then
      exec >&3
      exec 3>&-

      local _json_action
      for _json_action in "${ACTIONS[@]}"; do
        json_add_action "$_json_action"
      done
      local _json_penalty _json_score _json_rating
      _json_penalty=$(( WARN_COUNT * 4 + FAIL_COUNT * 8 ))
      _json_score=$(( 100 - _json_penalty ))
      if (( _json_score < 0 )); then
        _json_score=0
      fi
      if (( _json_score >= 90 )); then
        _json_rating="Excellent"
      elif (( _json_score >= 75 )); then
        _json_rating="Good"
      elif (( _json_score >= 50 )); then
        _json_rating="Needs attention"
      else
        _json_rating="Critical – fix issues ASAP"
      fi
      json_build_output "$_json_score" "$_json_rating" "$WARN_COUNT" "$FAIL_COUNT"
      return "$_check_rc"
    fi

    # Show summary for single module
    if ((${#ACTIONS[@]} > 0)); then
      echo
      echo "${BOLD}Actions:${RESET}"
      local i=1
      for action in "${ACTIONS[@]}"; do
        echo "  ${i}. ${action}"
        i=$((i + 1))
      done
    fi
    return "$_check_rc"
  else
    # Run full doctor, propagating its exit code like cmd_fix does.
    local _doctor_rc=0
    if is_truthy "$json_flag"; then
      JSON_ENABLED=true MDOCTOR_VERSION="${MDOCTOR_VERSION}" MDOCTOR_DEBUG="${MDOCTOR_DEBUG}" bash "${MDOCTOR_DIR}/doctor.sh" || _doctor_rc=$?
    else
      MDOCTOR_VERSION="${MDOCTOR_VERSION}" MDOCTOR_DEBUG="${MDOCTOR_DEBUG}" bash "${MDOCTOR_DIR}/doctor.sh" || _doctor_rc=$?
    fi
    return "$_doctor_rc"
  fi
}

########################################
# COMMAND: clean
########################################

cmd_clean() {
  local force=false module="" interactive=false

  # Shared common-flag parser (Task 8.4): --debug/--help handled once.
  parse_common_args usage_clean "$@" || return 0
  set -- ${_COMMON_REST[@]+"${_COMMON_REST[@]}"}

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=true; shift ;;
      --module|-m) module="$2"; shift 2 ;;
      --interactive|-i) interactive=true; shift ;;
      *) error "Unknown option: $1"; echo "Run 'mdoctor clean --help' for usage."; return 1 ;;
    esac
  done

  echo "${DIM}mdoctor v${MDOCTOR_VERSION_FULL}${RESET}"

  register_all_modules
  local cleanup_list
  cleanup_list="$(registry_names cleanup)"

  if is_truthy "$interactive" && [ -n "$module" ]; then
    error "Use either --module or --interactive, not both."
    return 1
  fi
  if [ -n "$module" ]; then
    if ! is_valid_cleanup_module "$cleanup_list" "$module"; then
      error "Unknown cleanup module: ${module}"
      registry_available_text cleanup "Available modules"
      return 1
    fi
    run_single_cleanup_module "$cleanup_list" "$module" "$force"
    return $?
  fi
  if is_truthy "$interactive"; then
    run_interactive_cleanup "$cleanup_list" "$force"
    return $?
  fi

  # Full cleanup (MDOCTOR_DEBUG set by the shared parser when --debug).
  local _args=()
  is_truthy "$force" && _args+=(--force)
  is_truthy "${MDOCTOR_DEBUG:-false}" && _args+=(--debug)
  if is_truthy "$force"; then
    MDOCTOR_ASSUME_YES="${MDOCTOR_ASSUME_YES:-false}" MDOCTOR_DEBUG="${MDOCTOR_DEBUG}" bash "${MDOCTOR_DIR}/cleanup.sh" ${_args[@]+"${_args[@]}"}
  else
    MDOCTOR_DEBUG="${MDOCTOR_DEBUG}" bash "${MDOCTOR_DIR}/cleanup.sh" ${_args[@]+"${_args[@]}"}
  fi
}

########################################
# COMMAND: fix
########################################

cmd_fix() {
  local target=""

  # Shared common-flag parser (Task 8.4): --debug/--help handled once.
  parse_common_args usage_fix "$@" || return 0
  set -- ${_COMMON_REST[@]+"${_COMMON_REST[@]}"}

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -*)
        error "Unknown option: $1"
        echo "Run 'mdoctor fix --help' for available targets."
        return 1
        ;;
      *)
        target="$1"
        shift
        ;;
    esac
  done

  source "${MDOCTOR_DIR}/lib/common.sh"
  source "${MDOCTOR_DIR}/lib/logging.sh"
  init_colors
  debug_log "cmd_fix target=${target:-<none>} debug=${MDOCTOR_DEBUG}"

  if [ -z "$target" ]; then
    usage_fix
    return 1
  fi

  # Platform gate (Task 1.2): macOS-only fix targets refuse on Linux
  # before any module code runs. Only the registry used by `fix all`
  # was gated; the dispatch case below was not.
  case "$target" in
    homebrew|permissions|spotlight|bluetooth|audio|wifi|timemachine|disk)
      if ! is_macos; then
        error "Fix target '${target}' is macOS-only (running on $(platform_name))."
        return 1
      fi
      ;;
  esac

  # Source fix modules
  local fix_file="${MDOCTOR_DIR}/fixes/${target}.sh"

  # Task 4.4: fix is an explicit apply — DRY_RUN defaults to false here
  # (DRY_RUN=true in the environment opts into a dry run, honored by
  # run_cmd_args in every module). The operations log records the session.
  DRY_RUN="${DRY_RUN:-false}"
  export DRY_RUN
  op_session_start "fix:${target}"

  local fix_rc=0
  case "$target" in
    homebrew|dns|disk|permissions|spotlight|bluetooth|audio|wifi|timemachine|apt)
      if [ -f "$fix_file" ]; then
        # shellcheck source=/dev/null
        source "$fix_file"
        debug_log "fix target start=${target}"
        "fix_${target}" || fix_rc=$?
        debug_log "fix target end=${target} rc=${fix_rc}"
      else
        error "Fix module not found: ${fix_file}"
        fix_rc=1
      fi
      ;;
    all)
      local -a fix_targets=(dns)
      if is_macos; then
        fix_targets+=(disk homebrew permissions spotlight bluetooth audio wifi)
      fi
      if is_linux; then
        fix_targets+=(apt)
      fi

      local t
      local all_rc=0
      for t in "${fix_targets[@]}"; do
        local f="${MDOCTOR_DIR}/fixes/${t}.sh"
        if [ -f "$f" ]; then
          # shellcheck source=/dev/null
          source "$f"
          debug_log "fix target start=${t}"
          local target_rc=0
          "fix_${t}" || target_rc=$?
          if [ "$target_rc" -ne 0 ]; then
            all_rc=$target_rc
          fi
          debug_log "fix target end=${t} rc=${target_rc}"
          echo
        fi
      done
      fix_rc="$all_rc"
      ;;
    *)
      error "Unknown fix target: ${target}"
      echo "Run 'mdoctor fix --help' for available targets."
      fix_rc=1
      ;;
  esac

  if [ "$fix_rc" -eq 0 ]; then
    op_session_end "ok"
  else
    op_session_end "error:${fix_rc}"
  fi
  return "$fix_rc"
}

########################################
# COMMAND: info
########################################

cmd_info() {
  echo "${BOLD}${BLUE}== System Information ==${RESET}"
  echo

  local arch uptime_str
  arch=$(uname -m 2>/dev/null || echo "Unknown")
  uptime_str=$(uptime | sed 's/.*up *//; s/, *[0-9]* user.*//')

  printf "  %-20s %s\n" "OS:" "$(platform_name)"
  printf "  %-20s %s\n" "Architecture:" "${arch}"
  printf "  %-20s %s\n" "Hostname:" "$(hostname)"
  printf "  %-20s %s\n" "Uptime:" "${uptime_str}"
  printf "  %-20s %s\n" "User:" "$(whoami)"
  printf "  %-20s %s\n" "Shell:" "${SHELL}"

  # Disk
  local disk_root="/"
  if is_macos; then
    [ -d /System/Volumes/Data ] && disk_root="/System/Volumes/Data"
  fi
  local disk_info
  disk_info=$(df -h "$disk_root" | awk 'NR==2 {print $3" used / "$2" total ("$5" used)"}')
  printf "  %-20s %s\n" "Disk:" "${disk_info}"

  # Memory
  if is_macos && command -v vm_stat >/dev/null 2>&1; then
    local page_size active_pages wired_pages
    page_size=$(sysctl -n hw.pagesize 2>/dev/null || echo 4096)
    active_pages=$(vm_stat | awk '/Pages active/ {gsub("\\.","",$3); print $3}')
    wired_pages=$(vm_stat | awk '/Pages wired down/ {gsub("\\.","",$4); print $4}')

    local total_mem
    total_mem=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
    local total_hr
    total_hr=$(human_readable_kb "$(( total_mem / 1024 ))")
    local used_kb
    used_kb=$(( (active_pages + wired_pages) * page_size / 1024 ))
    local used_hr
    used_hr=$(human_readable_kb "$used_kb")

    printf "  %-20s %s\n" "Memory:" "${used_hr} used / ${total_hr} total"
  elif is_linux && [ -r /proc/meminfo ]; then
    local mem_total mem_avail mem_used_kb total_hr used_hr
    mem_total=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
    mem_avail=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    mem_used_kb=$((mem_total - mem_avail))
    total_hr=$(human_readable_kb "$mem_total")
    used_hr=$(human_readable_kb "$mem_used_kb")

    printf "  %-20s %s\n" "Memory:" "${used_hr} used / ${total_hr} total"
  fi

  # CPU
  local cpu_brand
  if is_macos; then
    cpu_brand=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo "Unknown")
  elif [ -r /proc/cpuinfo ]; then
    cpu_brand=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//')
    [ -z "$cpu_brand" ] && cpu_brand="Unknown"
  else
    cpu_brand="Unknown"
  fi
  printf "  %-20s %s\n" "CPU:" "${cpu_brand}"

  # Load
  local load
  if is_macos; then
    load=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2", "$3", "$4}')
  else
    load=$(awk '{print $1", "$2", "$3}' /proc/loadavg 2>/dev/null || echo "Unknown")
  fi
  printf "  %-20s %s\n" "Load (1/5/15m):" "${load}"

  # Key tools
  echo
  echo "${BOLD}  Installed Tools:${RESET}"
  local -a tools=("git" "node" "npm" "python3" "pip3" "docker" "code" "java")
  if is_macos; then
    tools=("brew" "${tools[@]}")
  fi
  for tool in "${tools[@]}"; do
    if command -v "$tool" >/dev/null 2>&1; then
      local ver
      case "$tool" in
        brew)    ver=$(brew --version 2>/dev/null | head -n1) ;;
        git)     ver=$(git --version 2>/dev/null) ;;
        node)    ver=$(node -v 2>/dev/null) ;;
        npm)     ver=$(npm -v 2>/dev/null) ;;
        python3) ver=$(python3 --version 2>/dev/null) ;;
        pip3)    ver=$(pip3 --version 2>/dev/null | awk '{print $2}') ;;
        docker)  ver=$(docker --version 2>/dev/null) ;;
        code)    ver=$(code --version 2>/dev/null | head -n1) ;;
        java)    ver=$(java -version 2>&1 | head -n1) ;;
        *)       ver="installed" ;;
      esac
      printf "    ${GREEN}%-12s${RESET} %s\n" "${tool}" "${ver}"
    fi
  done
  echo
}

